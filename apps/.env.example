# ---------------------------------------------------------------------------
# Data Modeler Agent - example environment configuration
# Copy this file to `.env` and fill in the values. Nothing here is hardcoded
# in the app; the UI can still override the DEFAULT_* values below.
# ---------------------------------------------------------------------------

# --- Gemini (optional) -----------------------------------------------------
# The agent can use Google Gemini (Flash) to reason about the star schema.
# If no backend is configured, it falls back to a deterministic heuristic.
GEMINI_MODEL=gemini-2.5-flash
# Max output tokens for the model response (2.5 models: thinking is disabled so
# the whole budget goes to the JSON). Raise for very large schemas.
GEMINI_MAX_OUTPUT_TOKENS=32768

# Backend A: Vertex AI (recommended on GCP / Cloud Run).
# Auth uses ADC / the attached service account (needs roles/aiplatform.user).
# No API key required.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Backend B: Google AI Studio (API key). Only used when Vertex is NOT enabled.
# Get a key from https://aistudio.google.com/apikey
# Either GEMINI_API_KEY or GOOGLE_API_KEY is accepted.
GEMINI_API_KEY=

# --- GCP authentication ----------------------------------------------------
# Path to a service-account JSON key with BigQuery + GCS permissions.
# On Cloud Run you normally omit this and rely on the attached service account.
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery job location (US, EU, us-central1, ...). Must match your datasets.
BQ_LOCATION=US

# --- Optional UI defaults (pre-fill the form; never required) --------------
DEFAULT_GCP_PROJECT=
DEFAULT_SILVER_DATASET=
DEFAULT_GOLD_DATASET=
DEFAULT_GCS_BUCKET=

# --- Analysis limits -------------------------------------------------------
SAMPLE_ROW_LIMIT=20
MAX_TABLES=100

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
